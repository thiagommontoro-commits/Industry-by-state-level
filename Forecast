    <style>
        :root {
            --agco-red: #C8102E;
            --agco-red-hover: #A30B22;
            --agco-black: #111111;
            --primary-bg: #F5F5F5;
            --card-bg: #FFFFFF;
            --text-heading: #111111;
            --text-body: #3A3A3A;
            --text-muted: #6B7280;
            --border-color: #E5E7EB;
            --shadow-soft: 0 2px 4px -1px rgba(0, 0, 0, 0.06), 0 1px 2px -1px rgba(0, 0, 0, 0.04);
            --color-hp: #0B7A3B;
            --color-hn: #C8102E;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', 'Montserrat', sans-serif; }
        body {
            background-color: var(--primary-bg);
            color: var(--text-body);
            padding: 40px 20px;
            -webkit-font-smoothing: antialiased;
            line-height: 1.5;
        }
        .container { max-width: 1600px; margin: 0 auto; }
        
        /* Header */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 40px;
            padding-bottom: 20px;
            border-bottom: 2px solid var(--border-color);
        }
        .header h1 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-heading);
            letter-spacing: -0.5px;
            border-left: 5px solid var(--agco-red);
            padding-left: 15px;
        }
        .header p {
            color: var(--text-muted);
            font-size: 1rem;
            margin-top: 8px;
            padding-left: 20px;
        }
        .header span {
            background: var(--agco-red) !important;
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
        }
        
        /* Filters */
        .filter-container {
            display: flex;
            gap: 12px;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }
        .filter-btn {
            background-color: var(--card-bg);
            color: var(--text-body);
            border: 1px solid var(--border-color);
            padding: 10px 20px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease-in-out;
        }
        .filter-btn:hover {
            background-color: #e9ecef;
            border-color: #ced4da;
        }
        .filter-btn.active {
            background-color: var(--agco-red);
            color: white;
            border-color: var(--agco-red);
        }

        /* KPIs */
        .kpi-wrapper {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 24px;
            margin-bottom: 40px;
        }
        .kpi-card {
            background: var(--card-bg);
            padding: 24px;
            border-radius: 12px;
            box-shadow: var(--shadow-soft);
            border: 1px solid var(--border-color);
            border-left: 5px solid var(--agco-red);
        }
        .kpi-card h3 {
            font-size: 13px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 12px;
            font-weight: 600;
        }
        .kpi-card .value {
            font-size: 24px;
            font-weight: 700;
            color: var(--text-heading);
        }
        
        /* Table */
        .table-container {
            background: var(--card-bg);
            padding: 24px;
            border-radius: 12px;
            box-shadow: var(--shadow-soft);
            border: 1px solid var(--border-color);
        }
        .table-scroll-container {
            overflow-x: auto;
            direction: rtl;
        }
        .table-title-wrapper {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .export-btn {
            background-color: #0B7A3B;
            color: white;
            border: none;
            padding: 10px 18px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: background-color 0.2s ease-in-out;
        }
        .export-btn:hover {
            background-color: #085c2d;
        }
        .export-btn svg {
            width: 16px;
            height: 16px;
            fill: currentColor;
        }
        .table-container h2 {
            font-size: 1.25rem;
            color: var(--text-heading);
            font-weight: 600;
            text-align: left;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 1400px;
            direction: ltr; /* Reseta a direção para a tabela */
        }
        th, td {
            padding: 14px 16px;
            text-align: right;
            border-bottom: 1px solid var(--border-color);
            font-size: 14px;
            white-space: nowrap;
        }
        th:nth-child(1), td:nth-child(1),
        th:nth-child(2), td:nth-child(2),
        th:last-child, td:last-child {
            text-align: left;
        }
        th {
            background-color: #f9fafb;
            color: var(--text-muted);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 12px;
            letter-spacing: 0.5px;
            position: sticky;
            top: 0;
            z-index: 10;
        }
        tbody tr:hover td {
            background-color: #f5f5f5;
        }
        .col-27 {
            font-weight: 700;
            color: var(--text-heading);
            background-color: #f9fafb;
        }
        .uf-label {
            font-weight: 700;
            color: var(--text-heading);
        }
        .just-col {
            color: var(--text-body);
            font-size: 13px;
            line-height: 1.5;
            max-width: 350px;
            white-space: normal;
            text-align: left;
        }
        .positive { color: var(--color-hp); }
        .negative { color: var(--color-hn); }
    </style>
</head>

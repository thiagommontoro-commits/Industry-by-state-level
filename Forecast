    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const filterContainer = document.querySelector('.filter-container');
            const tableRows = document.querySelectorAll('tbody tr');
    
            if (filterContainer) {
                filterContainer.addEventListener('click', function(e) {
                    if (!e.target.matches('.filter-btn')) {
                        return;
                    }
    
                    // Update active button state
                    filterContainer.querySelector('.active').classList.remove('active');
                    e.target.classList.add('active');
    
                    const filter = e.target.dataset.filter;
    
                    // Filter table rows
                    tableRows.forEach(row => {
                        if (filter === 'todos' || row.dataset.region === filter) {
                            row.style.display = ''; // Show row by reverting to default
                        } else {
                            row.style.display = 'none'; // Hide row
                        }
                    });
                });
            }

            const exportBtn = document.getElementById('export-excel-btn');
            if (exportBtn) {
                exportBtn.addEventListener('click', function() {
                    const table = document.querySelector('.table-container table');
                    if (!table) return;

                    // Clone table to avoid modifying the one in the DOM
                    const tableClone = table.cloneNode(true);

                    // Remove rows hidden by the filter from the clone
                    tableClone.querySelectorAll('tbody tr[style*="display: none"]').forEach(row => row.remove());

                    const wb = XLSX.utils.table_to_book(tableClone, { sheet: "Projeção por Estado" });
                    XLSX.writeFile(wb, "Projecao_por_Estado_2027.xlsx");
                });
            }
        });
    </script>
